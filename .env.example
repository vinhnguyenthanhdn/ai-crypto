# Exchange chính — read-only API key, không cấp quyền trade/withdraw
EXCHANGE_ID=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Binance (nguồn thứ 2 — multi-exchange Collector, xem plan-02.md mục 5) — read-only API key
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Symbol & timeframe
SYMBOL=BTC/USDT
TIMEFRAME=5m
MARKET_TYPE=spot
LEVERAGE=1
FEATURE_VERSION=rule_features_v1
STRATEGY_PACKAGE_ID=rule_engine_v1
SCORING_PROFILE=champion
BTC_SPOT_TREND_ENABLED=false
BTC_SPOT_TREND_PACKAGE_ID=btc_spot_vol_scaled_trend_v1
STAGGERED_PULLBACK_ENABLED=false
STAGGERED_PULLBACK_PACKAGE_ID=btc_staggered_pullback_4h_profit_v2
STAGGERED_PULLBACK_RISK_PER_EXCURSION_PCT=1.0
RUNTIME_ENGINE_VERSION=runtime_v2
PAPER_ENGINE_VERSION=paper_engine_v2

# EXP-SR-SCORE-V4 (score V3 + TP multi-high/Fibonacci V2)
SR_EXPERIMENT_ID=EXP-SR-SCORE-V4
SR_SCORE_VERSION=sr_score_v3_partial_hyperbolic
SR_TP_POLICY_VERSION=tp_multi_high_fib_v2
SR_SWING_WINDOW=3
SR_SWING_LOOKBACK=100
SR_REQUIRED_SWINGS=2
SR_DECISION_THRESHOLD=70
SR_SAME_ZONE_MAX_SPREAD_ATR=0.25
SR_APPROACH_WIDTH_ATR=0.30
SR_BUY_THRESHOLD_DISTANCE_ATR=0.09
SR_SCORE_FLOOR=0.01
SR_FAKE_BREAK_WICK_ATR=0.15
SR_INVALIDATION_CLOSE_ATR=0.20
SR_ZONE_QUALITY_1=0.50
SR_ZONE_QUALITY_2=1.00
SR_ZONE_QUALITY_3=0.90
SR_ZONE_QUALITY_4_PLUS=0.70
SR_SL_BUFFER_ATR=0.20
SR_FAR_RESISTANCE_ATR=3.00
SR_FIB_LEVELS=0.382,0.500,0.618,0.786
SR_MIN_RISK_REWARD=1.50

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk management
ACCOUNT_EQUITY_USD=500
RISK_PER_TRADE_PCT=1.5
DAILY_LOSS_LIMIT_PCT=5
MAX_DRAWDOWN_PCT=15
COOLDOWN_MINUTES=30
MAX_CONCURRENT_POSITIONS=1
MAX_HOLD_MINUTES=1440
ATR_STOP_MULTIPLIER=1.5
RISK_REWARD_RATIO=1.5

# Chi phí giao dịch một chiều, dạng thập phân (0.001 = 0.1%) — chi phí khứ hồi = (FEE+SLIPPAGE)*2
FEE_PCT=0.001
SLIPPAGE_PCT=0.0005
# Cost gate: TP phải cách entry ít nhất k lần chi phí khứ hồi, nếu không thì bỏ qua entry
# (xem docs/research-technical-signal-edge.md mục 8)
MIN_TP_COST_RATIO=2.5

# Decision thresholds
BUY_SCORE_THRESHOLD=70
WATCH_SCORE_THRESHOLD=55

# Launchd activation + monitoring window bằng WS tick
MONITOR_WINDOW_MINUTES=5
MONITOR_POLL_SECONDS=5
ACTIVATION_INTERVAL_MINUTES=60
RUN_SCHEDULED=false
RUN_CONTINUOUS=false
CONTINUOUS_RETRY_SECONDS=30
MARKET_TICK_MAX_AGE_SECONDS=30
RUN_LOCK_STALE_MINUTES=5

# Basis-risk gate, mặc định tắt
CROSS_EXCHANGE_DIVERGENCE_GATE_ENABLED=false
MAX_CROSS_EXCHANGE_DIVERGENCE_PCT=0.15

# Health/report
HEALTHCHECK_MAX_STALE_MINUTES=30
AI_REPORT_CACHE_TTL_SECONDS=300

# Hệ số tương quan Cross-market (mục 7b) — cập nhật khi tương quan thị trường đổi
CROSSMARKET_NASDAQ_COEF=4
CROSSMARKET_DXY_COEF=4
CROSSMARKET_VIX_COEF=-1.5
