# Exchange chính (Phase 1, single-exchange cron pipeline) — read-only API key, không cấp quyền trade/withdraw
EXCHANGE_ID=okx
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Binance (nguồn thứ 2 — multi-exchange Collector, xem plan-02.md mục 5) — read-only API key
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Symbol & timeframe
SYMBOL=BTC/USDT
TIMEFRAME=5m

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Risk management
ACCOUNT_EQUITY_USD=500
RISK_PER_TRADE_PCT=1.5
DAILY_LOSS_LIMIT_PCT=5
MAX_DRAWDOWN_PCT=15
COOLDOWN_MINUTES=30
MAX_CONCURRENT_POSITIONS=1
MIN_HOLD_MINUTES=15
ATR_STOP_MULTIPLIER=1.5
RISK_REWARD_RATIO=1.5

# Chi phí giao dịch một chiều, dạng thập phân (0.001 = 0.1%) — chi phí khứ hồi = (FEE+SLIPPAGE)*2
FEE_PCT=0.001
SLIPPAGE_PCT=0.0005
# Cost gate: TP phải cách entry ít nhất k lần chi phí khứ hồi, nếu không thì bỏ qua entry
# (xem docs/research-technical-signal-edge.md mục 8)
MIN_TP_COST_RATIO=2.5

# Decision thresholds
BUY_SCORE_THRESHOLD=70
WATCH_SCORE_THRESHOLD=55

# Cron (x, cấu hình qua launchd/cron) + cửa sổ theo dõi liên tục bằng WS tick (y, mục 5d)
MONITOR_WINDOW_MINUTES=5
MONITOR_POLL_SECONDS=5

# Hệ số tương quan Cross-market (mục 7b) — cập nhật khi tương quan thị trường đổi
CROSSMARKET_NASDAQ_COEF=4
CROSSMARKET_DXY_COEF=4
CROSSMARKET_VIX_COEF=-1.5
